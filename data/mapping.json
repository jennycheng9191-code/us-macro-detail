  "pce_core_services_ex_housing": {
    "source": "derived",
    "method": "weighted_ex_component",
    "freq": "M",
    "display": "yoy",
    "also": [
      "mom"
    ],
    "unit": "%",
    "component_a": {
      "price_table": "U20404",
      "price_line": 376,
      "price_series": "IA000063",
      "weight_table": "U20405",
      "weight_line": 376,
      "weight_series": "LA000063",
      "label": "PCE services excluding energy"
    },
    "component_b": {
      "price_table": "U20404",
      "price_line": 153,
      "price_series": "DHSGRG",
      "weight_table": "U20405",
      "weight_line": 153,
      "weight_series": "DHSGRC",
      "label": "Housing"
    },
    "formula": "(w_a(t-1)*chg_a - w_b(t-1)*chg_b) / (w_a(t-1) - w_b(t-1))，以B期名目支出當權重的Laspeyres近似",
    "note": "BEA未直接公布此組合指數，這是用名目支出權重反推的近似值，卡片需標註「近似計算，非BEA官方直接數字」",
    "sanity": {
      "min": -3,
      "max": 10
    },
    "stale_days": 45
  },
