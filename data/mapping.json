  "pce_headline": { "source": "bea", "dataset": "NIUnderlyingDetail", "table": "U20404", "line": 1, "series": "DPCERG", "freq": "M", "display": "pct_change_yoy", "also": ["pct_change_mom"], "unit": "%" },
  "pce_core": { "source": "bea", "dataset": "NIUnderlyingDetail", "table": "U20404", "line": 374, "series": "DPCCRG", "freq": "M", "display": "pct_change_yoy", "also": ["pct_change_mom"], "unit": "%", "note": "PCE excluding food and energy" },
  "pce_goods": { "source": "bea", "dataset": "NIUnderlyingDetail", "table": "U20404", "line": 2, "series": "DGDSRG", "freq": "M", "display": "pct_change_yoy", "also": ["pct_change_mom"], "unit": "%" },
  "pce_services": { "source": "bea", "dataset": "NIUnderlyingDetail", "table": "U20404", "line": 150, "series": "DSERRG", "freq": "M", "display": "pct_change_yoy", "also": ["pct_change_mom"], "unit": "%" },
  "pce_core_services_ex_housing": {
    "source": "derived",
    "method": "weighted_ex_component",
    "freq": "M",
    "display": "pct_change_yoy",
    "also": ["pct_change_mom"],
    "unit": "%",
    "component_a": { "price_table": "U20404", "price_line": 376, "price_series": "IA000063", "weight_table": "U20405", "weight_line": 376, "weight_series": "LA000063", "label": "PCE services excluding energy" },
    "component_b": { "price_table": "U20404", "price_line": 153, "price_series": "DHSGRG", "weight_table": "U20405", "weight_line": 153, "weight_series": "DHSGRC", "label": "Housing" },
    "formula": "(w_a(t-1)*chg_a - w_b(t-1)*chg_b) / (w_a(t-1) - w_b(t-1))，以B期名目支出當權重的Laspeyres近似",
    "note": "BEA未直接公布此組合指數，這是用名目支出權重反推的近似值，卡片需標註「近似計算，非BEA官方直接數字」"
  },

