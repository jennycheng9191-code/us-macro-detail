{
  "_doc": {
    "說明": "7指標拆項的資料來源對應表。所有序列代號於2026-08-08逐一以官方API測試呼叫驗證過（非憑記憶填寫）。",
    "source 分類": {
      "bea": "BEA API，dataset+table+line鎖定單一時間序列，需 BEA_API_KEY",
      "bls": "BLS Public API v2，series為BLS官方序列代號，需 BLS_API_KEY",
      "census": "Census MARTS Timeseries API，需 CENSUS_API_KEY",
      "prnewswire": "ISM官方新聞稿全文解析，沿用us-macro-guide的scripts/sources/prnewswire.py",
      "derived": "由本表其他項目計算得出，不直接對應單一官方序列"
    },
    "display": "level=原始值(通常已是%) | pct_change_mom=指數月增率 | pct_change_yoy=指數年增率 | diff=期間差值(就業人數用) | weighted_ex_component=名目權重反推排除法(見PCE核心服務排除房租)",
    "驗證時間": "2026-08-08，BEA/BLS/Census三把金鑰皆已啟用測試成功"
  },

  "gdp_headline": { "source": "bea", "dataset": "NIPA", "table": "T10101", "line": 1, "series": "A191RL", "freq": "Q", "display": "level", "unit": "%", "note": "頭條數字，已是年化季增率" },
